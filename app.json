{
  "expo": {
    "name": "Ploop",
    "slug": "ploop",
    "scheme": "ploop",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#13162B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suvink.ploop"
    },
    "android": {
      "package": "com.suvink.ploop",
      "adaptiveIcon": {
        "backgroundColor": "#14183A",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#14183A"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Fredoka-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ploop uses the camera to scan the barcode on your boarding pass. Nothing leaves your phone.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ploop reads a boarding pass screenshot you choose to find its barcode.",
          "cameraPermission": "Ploop uses the camera to scan the barcode on your boarding pass. Nothing leaves your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ploop saves story images to your photos.",
          "savePhotosPermission": "Ploop saves story images to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Room generated classes (WorkManager, used by Google Mobile Ads) are created by reflection\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n-keep class androidx.startup.** { *; }\n-keep class * implements androidx.startup.Initializer { <init>(); }"
          }
        }
      ]
    ],
    "description": "Every flight as a little story. A flight log and passport for Android.",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c30838bc-7eb4-4270-bf67-e730b39fc342"
      }
    },
    "owner": "suvink"
  }
}
